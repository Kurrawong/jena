PREFIX luc:     <urn:jena:lucene:index#>

SELECT ?value ?count
WHERE {
    (?field ?value ?low ?high ?count) luc:facet (
        "default"                                # index
        "default"                                # fields
        "*"                                      # query
        '["urn:jena:lucene:field#contributor"]'  # facets
        ""                                       # filter
        20                                       # max values
        0                                        # min count
    ) .
}
ORDER BY DESC(?count) ?value
