PREFIX luc: <urn:jena:lucene:index#>
PREFIX idx: <urn:jena:lucene:index#>

SELECT ?field ?name ?type
WHERE {
    (?field idx:fieldName ?name) luc:config ("default") .
    (?field idx:fieldType ?type) luc:config ("default") .
}
ORDER BY ?name
