# FEATURE 7 — same-child correlation, the reason nested records exist.
#
# "Priya gave it five stars" — both clauses must be satisfied by ONE review row, not by
# two different ones. Tonkotsu Ramen (Noor 5, Priya 2) and Mole Poblano (Noor 5, Priya 3)
# each have a Priya review AND a five-star review, but no five-star Priya review, so
# neither may appear. Expect exactly: Slow-Braised Beef Shin, Cacio e Pepe, Miso Soup.

PREFIX luc:  <urn:jena:lucene:index#>
PREFIX schema:  <https://schema.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?name
WHERE {
    (?hit ?entity) luc:query (
        "default" "default" ""
        '{"op":"and","args":[{"op":"=","args":[{"property":"urn:jena:lucene:field#reviewer"},"Priya"]},{"op":"=","args":[{"property":"urn:jena:lucene:field#stars"},5]}]}'
        "" 20 0) .
    ?entity rdfs:label|schema:name|dcterms:title ?name .
}
ORDER BY ?name
