PREFIX luc:     <urn:jena:lucene:index#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX schema:  <https://schema.org/>

SELECT ?name ?field ?value
WHERE {
    (?hit ?entity) luc:query (
        "default"                                 # index
        "default"                                 # fields
        ""                                        # query
        '{"op":"and","args":[{"op":"=","args":[{"property":"urn:jena:lucene:field#ingredient"},"http://example.org/kitchen/ing-chilli"]},{"op":">=","args":[{"property":"urn:jena:lucene:field#ingredientGrams"},100]}]}'  # filter
        ""                                        # sort
        20                                        # limit
        0                                         # offset
    ) .
    (?hit ?record ?field ?value) luc:nestedMatch () .
    ?entity rdfs:label|schema:name|dcterms:title ?name .
}
ORDER BY ?name ?field
