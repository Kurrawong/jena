PREFIX luc:     <urn:jena:lucene:index#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX schema:  <https://schema.org/>
PREFIX kt:      <http://example.org/kitchen/>

SELECT ?entity ?name ?code
WHERE {
    (?hit ?entity) luc:query (
        "default"                                 # index
        "default"                                 # fields
        ""                                        # query
        '{"op":"text_query","args":[{"property":"urn:jena:lucene:field#codeText"},"2019"]}'  # filter
        ""                                        # sort
        20                                        # limit
        0                                         # offset
    ) .
    ?entity rdfs:label|schema:name|dcterms:title ?name .
    ?entity kt:code ?code .
}
ORDER BY ?code
