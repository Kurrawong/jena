PREFIX luc:     <urn:jena:lucene:index#>

SELECT ?field ?value ?count
WHERE {
    (?field ?value ?low ?high ?count) luc:facet (
        "default"                                 # index
        "default"                                 # fields
        "*"                                       # query
        '["urn:jena:lucene:field#course","urn:jena:lucene:field#diet","urn:jena:lucene:field#contributor"]'  # facets
        ""                                        # filter
        20                                        # max values
        0                                         # min count
    ) .
}
ORDER BY ?field DESC(?count) ?value
