PREFIX luc:     <urn:jena:lucene:index#>

SELECT ?field ?low ?high ?count
WHERE {
    (?field ?value ?low ?high ?count) luc:facet (
        "default"                                 # index
        "default"                                 # fields
        "*"                                       # query
        '[{"field":"urn:jena:lucene:field#prepMinutes","ranges":[null,20,60,240,null]}]'  # facets
        ""                                        # filter
        20                                        # max values
        0                                         # min count
    ) .
}
ORDER BY ?low
