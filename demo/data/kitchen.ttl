    kt:testedBy kt:person-dara;
    kt:ingredient
        [ kt:item kt:ing-fish ; kt:grams 500 ] ,
        [ kt:item kt:ing-lime ; kt:grams 150 ] ,
        [ kt:item kt:ing-chilli ; kt:grams 5 ].

kt:recipe-r08 a kt:Recipe ;
    dcterms:title "Mole Poblano" ;
    dcterms:description "Chillies, nuts and a little chocolate ground into a dark sauce and simmered slowly over turkey." ;
    kt:code "RCP-2022-0271" ;
    kt:country kt:country-mexico ;
    kt:course kt:course-main ;
    kt:prepMinutes 300 ;
    kt:publishedOn "2022-10-19"^^xsd:date ;
