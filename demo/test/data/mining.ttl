@prefix ex:         <http://example.org/mining/> .
@prefix commodity:  <http://example.org/mining/commodity/> .
@prefix state:      <http://example.org/mining/state/> .
@prefix operator:   <http://example.org/mining/operator/> .
@prefix status:     <http://example.org/mining/status/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:   <http://www.opengis.net/ont/geosparql#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .

## --- Classes ---

ex:MiningReport rdfs:label "Mining Report" .
ex:Borehole     rdfs:label "Borehole" .
ex:Site         rdfs:label "Site" .

## --- Vocabulary IRIs ---

commodity:Copper    rdfs:label "Copper" .
commodity:Lead      rdfs:label "Lead" .
commodity:Zinc      rdfs:label "Zinc" .
commodity:Gold      rdfs:label "Gold" .
commodity:Silver    rdfs:label "Silver" .
commodity:Uranium   rdfs:label "Uranium" .
commodity:Iron-Ore  rdfs:label "Iron Ore" .

state:QLD  rdfs:label "QLD" .
state:SA   rdfs:label "SA" .
state:WA   rdfs:label "WA" .
state:NSW  rdfs:label "NSW" .
state:PNG  rdfs:label "PNG" .

operator:Saltbush  rdfs:label "Saltbush" .
operator:Warrigal       rdfs:label "Warrigal" .
operator:Bellbird   rdfs:label "Bellbird" .
operator:Quandong  rdfs:label "Quandong" .
operator:Corvid-Metals rdfs:label "Corvid Metals" .

status:Active      rdfs:label "Active" .
status:Historical  rdfs:label "Historical" .
status:Current     rdfs:label "Current" .

ex:PrincipalInvestigator rdfs:label "Principal Investigator" .
ex:Reviewer              rdfs:label "Reviewer" .
ex:DataSteward           rdfs:label "Data Steward" .

## --- Sites ---

ex:site-brolga-ridge a ex:Site ;
    rdfs:label "Brolga Ridge Mine" ;
    ex:identifier "SITE-MIA-001" ;
    dct:description "Major polymetallic mining complex in northwest Queensland producing copper, lead and zinc since 1923. One of the most significant base metal deposits in the world." ;
    ex:commodity commodity:Copper, commodity:Lead, commodity:Zinc ;
    ex:state state:QLD ;
    ex:status status:Active ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/4326> POINT(-20.73 139.49)"^^geo:wktLiteral .

ex:site-spinifex-dome a ex:Site ;
    rdfs:label "Spinifex Dome" ;
    ex:identifier "SITE-OD-001" ;
    dct:description "Underground mine in South Australia producing copper, uranium, gold and silver. Hosts one of the world's largest known ore deposits within an iron oxide copper-gold system." ;
    ex:commodity commodity:Copper, commodity:Uranium, commodity:Gold ;
    ex:state state:SA ;
    ex:status status:Active ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/4326> POLYGON((-30.50 136.80, -30.50 136.96, -30.36 136.96, -30.36 136.80, -30.50 136.80))"^^geo:wktLiteral .

ex:site-wattle-downs a ex:Site ;
    rdfs:label "Wattle Downs Gold Mine" ;
    ex:identifier "SITE-BOD-001" ;
    dct:description "Large open-pit gold-copper mine in the Pardalote Range of Western Australia. Currently the largest gold mine in the country by production volume." ;
    ex:commodity commodity:Gold, commodity:Copper ;
    ex:state state:WA ;
    ex:status status:Active ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/4326> POINT(-32.77 116.35)"^^geo:wktLiteral .

ex:site-echidna-hill a ex:Site ;
    rdfs:label "Echidna Hill Mine" ;
    ex:identifier "SITE-BH-001" ;
    dct:description "Historic lead-zinc-silver mining district in far western New South Wales. Mining commenced in 1883, making it one of the longest continuously operating mining fields in Australia." ;
    ex:commodity commodity:Lead, commodity:Zinc, commodity:Silver ;
    ex:state state:NSW ;
    ex:status status:Historical ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/4326> POLYGON((-32.00 141.40, -32.00 141.55, -31.90 141.55, -31.90 141.40, -32.00 141.40))"^^geo:wktLiteral .

ex:site-kurrajong-valley a ex:Site ;
    rdfs:label "Kurrajong Valley Operations" ;
    ex:identifier "SITE-CAD-001" ;
    dct:description "Underground panel cave and open-pit gold-copper mine near Orange, New South Wales. One of Australia's largest gold operations, extracting from a porphyry copper-gold deposit." ;
    ex:commodity commodity:Gold, commodity:Copper ;
    ex:state state:NSW ;
    ex:status status:Active ;
    geo:asWKT "POLYGON((148.90 -33.55, 149.10 -33.55, 149.10 -33.40, 148.90 -33.40, 148.90 -33.55))"^^geo:wktLiteral .

ex:site-redgum-iron a ex:Site ;
    rdfs:label "Redgum Iron Ore Hub" ;
    ex:identifier "SITE-PIL-001" ;
    dct:description "Cluster of open-pit iron ore mines in the Redgum region of Western Australia. Produces high-grade hematite ore for export, connected by private rail to port facilities." ;
    ex:commodity commodity:Iron-Ore ;
    ex:state state:WA ;
    ex:status status:Active ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/4326> POLYGON((-22.8 118.0, -22.8 119.2, -21.8 119.2, -21.8 118.0, -22.8 118.0))"^^geo:wktLiteral .

ex:site-redgum-cluster a ex:Site ;
    rdfs:label "Redgum Cluster Project" ;
    dct:description "Multipart Redgum tenement example represented as a MultiPolygon footprint with two disjoint lease areas for spatial indexing demos." ;
    ex:commodity commodity:Iron-Ore, commodity:Gold ;
    ex:state state:WA ;
    ex:status status:Active ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/4326> MULTIPOLYGON(((-22.30 118.20, -22.30 118.30, -22.20 118.30, -22.20 118.20, -22.30 118.20)),((-22.45 118.45, -22.45 118.55, -22.35 118.55, -22.35 118.45, -22.45 118.45)))"^^geo:wktLiteral .

ex:site-kanawa-ridge a ex:Site ;
    rdfs:label "Kanawa Ridge Mine" ;
    ex:identifier "SITE-OKT-001" ;
    dct:description "Large open-pit copper-gold mine in the Star Mountains of Papua New Guinea. One of the largest copper and gold deposits in the world, operating since 1984." ;
    ex:commodity commodity:Copper, commodity:Gold ;
    ex:state state:PNG ;
    ex:status status:Active ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/4326> POINT(-5.20 141.13)"^^geo:wktLiteral .

## --- Boreholes ---
## The schema:identifier records model the qualified-value pattern behind issue #39.
## Each borehole carries three correlated blank-node identifier records:
## company, anumber, and mnumber.

ex:bh-bro-001 a ex:Borehole ;
    rdfs:label "BRO-DDH-001 Brolga Ridge Diamond Drill Hole" ;
    ex:identifier "BRO-DDH-001" ;
    dct:description "Diamond drill hole targeting the copper-rich silica dolomite zone at 400m depth. Core recovery 95%. Intersected significant chalcopyrite mineralisation below 380m." ;
    ex:commodity commodity:Copper ;
    ex:state state:QLD ;
    ex:depth 450 ;
    schema:identifier
        [ schema:propertyID "company" ; schema:value "Saltbush" ],
        [ schema:propertyID "anumber" ; schema:value "A9412" ],
        [ schema:propertyID "mnumber" ; schema:value "BRO-DDH-001" ] ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/4326> POINT(-20.74 139.50)"^^geo:wktLiteral .

ex:bh-bro-002 a ex:Borehole ;
    rdfs:label "BRO-DDH-002 Brolga Ridge Exploration Hole" ;
    ex:identifier "BRO-DDH-002" ;
    dct:description "Exploration hole in the northern lead-zinc zone targeting Urquhart Shale stratigraphy. Encountered sphalerite and galena mineralisation between 210m and 290m." ;
    ex:commodity commodity:Lead, commodity:Zinc ;
    ex:state state:QLD ;
    ex:depth 320 ;
    schema:identifier
        [ schema:propertyID "company" ; schema:value "Saltbush" ],
        [ schema:propertyID "anumber" ; schema:value "A9413" ],
        [ schema:propertyID "mnumber" ; schema:value "BRO-DDH-002" ] .

ex:bh-spx-001 a ex:Borehole ;
    rdfs:label "SPX-RC-001 Spinifex Dome Reverse Circulation Hole" ;
    ex:identifier "SPX-RC-001" ;
    dct:description "Reverse circulation hole drilled into the Spinifex Dome breccia complex. Targeted the hematite-quartz breccia unit hosting copper-uranium mineralisation." ;
    ex:commodity commodity:Copper, commodity:Uranium ;
    ex:state state:SA ;
    ex:depth 280 ;
    schema:identifier
        [ schema:propertyID "company" ; schema:value "Warrigal" ],
        [ schema:propertyID "anumber" ; schema:value "A1208" ],
        [ schema:propertyID "mnumber" ; schema:value "SPX-RC-001" ] .

ex:bh-wat-001 a ex:Borehole ;
    rdfs:label "WAT-DDH-001 Wattle Downs Deep Diamond Hole" ;
    ex:identifier "WAT-DDH-001" ;
    dct:description "Deep diamond drill hole investigating the primary gold-copper mineralisation at depth beneath the existing open pit. Targeted the diorite-hosted stockwork zone below the supergene blanket." ;
    ex:commodity commodity:Gold ;
    ex:state state:WA ;
    ex:depth 600 ;
    schema:identifier
        [ schema:propertyID "company" ; schema:value "Bellbird" ],
        [ schema:propertyID "anumber" ; schema:value "A3301" ],
        [ schema:propertyID "mnumber" ; schema:value "WAT-DDH-001" ] ;
    geo:asWKT "POINT(116.36 -32.78)"^^geo:wktLiteral .

ex:bh-ech-001 a ex:Borehole ;
    rdfs:label "ECH-DDH-001 Echidna Hill Legacy Drill Hole" ;
    ex:identifier "ECH-DDH-001" ;
    dct:description "Historical diamond drill hole from the Echidna Hill main lode. Part of the 1970s exploration campaign that delineated the southern extension of the orebody." ;
    ex:commodity commodity:Lead, commodity:Silver ;
    ex:state state:NSW ;
    ex:depth 210 ;
    schema:identifier
        [ schema:propertyID "company" ; schema:value "Legacy Co" ],
        [ schema:propertyID "anumber" ; schema:value "A4402" ],
        [ schema:propertyID "mnumber" ; schema:value "ECH-DDH-001" ] .

ex:bh-kur-001 a ex:Borehole ;
    rdfs:label "KUR-DDH-001 Kurrajong Deep Exploration Hole" ;
    ex:identifier "KUR-DDH-001" ;
    dct:description "Deep exploration hole targeting the Kurrajong East porphyry at depth. Intersected a thick zone of sheeted quartz-sulphide veins with elevated gold and copper grades from 620m." ;
    ex:commodity commodity:Gold, commodity:Copper ;
    ex:state state:NSW ;
    ex:depth 850 ;
    schema:identifier
        [ schema:propertyID "company" ; schema:value "Quandong" ],
        [ schema:propertyID "anumber" ; schema:value "A5507" ],
        [ schema:propertyID "mnumber" ; schema:value "KUR-DDH-001" ] .

ex:bh-red-001 a ex:Borehole ;
    rdfs:label "RED-RC-001 Redgum Iron Ore Reverse Circulation" ;
    ex:identifier "RED-RC-001" ;
    dct:description "Shallow reverse circulation hole in the channel iron deposit. Sampled the Tertiary pisolitic limonite horizon for iron grade and contaminant analysis." ;
    ex:commodity commodity:Iron-Ore ;
    ex:state state:WA ;
    ex:depth 150 ;
    schema:identifier
        [ schema:propertyID "company" ; schema:value "Corvid Metals" ],
        [ schema:propertyID "anumber" ; schema:value "A6609" ],
        [ schema:propertyID "mnumber" ; schema:value "RED-RC-001" ] ;
    geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/4326> POINT(-22.35 118.60)"^^geo:wktLiteral .

## --- Authors ---
## Authors are separate entities linked to reports via ex:authoredBy (on reports)
## and ex:authored (on authors). This enables sequence and inverse path indexing.

ex:author-jones a ex:Author ;
    rdfs:label "Dr Sarah Jones" ;
    ex:name "Dr Sarah Jones" ;
    ex:affiliation "Federated Minerals Institute" ;
    ex:authored ex:report-bro-2023, ex:report-spx-2024 .

ex:author-chen a ex:Author ;
    rdfs:label "Prof Wei Chen" ;
    ex:name "Prof Wei Chen" ;
    ex:affiliation "National Geoscience Office" ;
    ex:authored ex:report-bro-2021, ex:report-ech-1985 .

ex:author-williams a ex:Author ;
    rdfs:label "James Williams" ;
    ex:name "James Williams" ;
    ex:affiliation "Corvid Metals Technical Services" ;
    ex:authored ex:report-red-2024, ex:report-red-exploration .

ex:author-patel a ex:Author ;
    rdfs:label "Dr Priya Patel" ;
    ex:name "Dr Priya Patel" ;
    ex:affiliation "Bellbird Geology" ;
    ex:authored ex:report-wat-2022, ex:report-kur-2023 .

## --- Mining Reports ---

ex:report-bro-2023 a ex:MiningReport ;
    rdfs:label "Brolga Ridge Copper Resource Estimation 2023" ;
    ex:identifier "RPT-MIA-2023-001" ;
    dct:description "Resource estimation for the Brolga Ridge copper deposit including updated geological model and grade interpolation using ordinary kriging." ;
    ex:commodity commodity:Copper ;
    ex:state state:QLD ;
    ex:operator operator:Saltbush ;
    ex:status status:Current ;
    ex:year 2023 ;
    ex:publishedOn "2023-11-18"^^xsd:date ;
    ex:indexedAt "2024-01-09T09:15:00+10:00"^^xsd:dateTime ;
    ex:reviewNote "QA validated by Brisbane modelling team."@en, "Validado por el equipo de modelado de Brisbane."@es ;
    ex:qaPassed true ;
    ex:confidenceScore "0.94"^^xsd:double ;
    ex:authoredBy ex:author-jones ;
    prov:qualifiedAttribution
        [ prov:hadRole ex:PrincipalInvestigator ; prov:agent ex:author-jones ],
        [ prov:hadRole ex:Reviewer ; prov:agent ex:author-patel ] .

ex:report-bro-2021 a ex:MiningReport ;
    rdfs:label "Brolga Ridge Lead-Zinc Exploration Summary" ;
    ex:identifier "RPT-MIA-2021-001" ;
    dct:description "Summary of exploration drilling in the northern extension of the Brolga Ridge lead-zinc orebody. Includes assay results and cross-sections." ;
    ex:commodity commodity:Lead, commodity:Zinc ;
    ex:state state:QLD ;
    ex:operator operator:Saltbush ;
    ex:status status:Current ;
    ex:year 2021 ;
    ex:publishedOn "2021-08-04"^^xsd:date ;
    ex:indexedAt "2024-01-10T08:00:00Z"^^xsd:dateTime ;
    ex:reviewNote "Legacy exploration summary retained for reference."@en, "Conservé pour référence."@fr ;
    ex:qaPassed true ;
    ex:confidenceScore "0.81"^^xsd:double ;
    ex:authoredBy ex:author-chen ;
    prov:qualifiedAttribution
        [ prov:hadRole ex:PrincipalInvestigator ; prov:agent ex:author-chen ],
        [ prov:hadRole ex:Reviewer ; prov:agent ex:author-jones ] .

ex:report-spx-2024 a ex:MiningReport ;
    rdfs:label "Spinifex Dome Expansion Feasibility Study" ;
    ex:identifier "RPT-OD-2024-001" ;
