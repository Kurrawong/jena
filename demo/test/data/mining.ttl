    rdfs:label "Multi Identifier Drillhole Record Demo" ;
    ex:identifier "", "94130", "DAG2011/00113216" ;
    dct:description "Demo report carrying multiple identifier values on one entity, including an empty identifier and two usable identifiers for the same drillhole record." ;
    ex:commodity commodity:Gold ;
    ex:state state:WA ;
    ex:operator operator:Bellbird ;
    ex:status status:Current ;
    ex:year 2011 ;
    ex:publishedOn "2011-05-12"^^xsd:date ;
    ex:indexedAt "2024-01-06T12:00:00+10:00"^^xsd:dateTime ;
    ex:reviewNote "Metadata regression fixture for luc:match."@en ;
    ex:qaPassed true ;
    ex:confidenceScore "0.72"^^xsd:double ;
    ex:authoredBy ex:author-patel ;
    prov:qualifiedAttribution
        [ prov:hadRole ex:DataSteward ; prov:agent ex:author-patel ] .
