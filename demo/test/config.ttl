PREFIX :        <#>
PREFIX field:   <urn:jena:lucene:field#>
PREFIX fuseki:  <http://jena.apache.org/fuseki#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ja:      <http://jena.hpl.hp.com/2005/11/Assembler#>
PREFIX tdb2:    <http://jena.apache.org/2016/tdb#>
PREFIX text:    <http://jena.apache.org/text#>
PREFIX idx:     <urn:jena:lucene:index#>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX ex:      <http://example.org/mining/>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX schema:  <https://schema.org/>

## --- Fuseki server ---

[] rdf:type fuseki:Server ;
   fuseki:services ( :service ) .

:service rdf:type fuseki:Service ;
    fuseki:name "mining" ;
    fuseki:endpoint [ fuseki:operation fuseki:query  ; fuseki:name "query"  ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ; fuseki:name "update" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ; fuseki:name "data"   ] ;
    fuseki:dataset :text_dataset .

## --- Text-indexed dataset ---

:text_dataset rdf:type text:TextDataset ;
    text:dataset :base_dataset ;
    text:indexes :index .

:base_dataset rdf:type tdb2:DatasetTDB ;
    tdb2:location "DB" .

:index rdf:type text:TextIndexShacl ;
    text:indexId "default" ;
    text:directory <file:Lucene> ;
    ## Required because BoreholeShape is rebuild-only (idx:externalSource):
    ## the index is built by a separate shacltextindexer process, and an
    ## in-memory taxonomy would die with it, silently emptying every
    ## hierarchical facet.
    text:taxonomyDirectory <file:Taxonomy> ;
    text:shapes ( :MiningReportShape :BoreholeShape :SiteShape ) ;
    text:storeValues false ;
    text:maxFacetHits 50000 .

## --- Field definitions (canonical, path-free) ---

field:entityType
    idx:fieldName "entityType" ;
    idx:fieldType idx:KeywordField ;
    idx:stored false ;
    idx:facetable true .

field:title
    idx:fieldName "title" ;
    idx:fieldType idx:TextField ;
    idx:stored true ;
    idx:defaultSearch true .

field:description
    idx:fieldName "description" ;
    idx:fieldType idx:TextField ;
    idx:stored true ;
    idx:defaultSearch true .

field:commodity
    idx:fieldName "commodity" ;
    idx:fieldType idx:KeywordField ;
    idx:stored false ;
    idx:facetable true ;
    idx:multiValued true .

field:state
    idx:fieldName "state" ;
    idx:fieldType idx:KeywordField ;
    idx:stored false ;
    idx:facetable true .

field:operator
    idx:fieldName "operator" ;
    idx:fieldType idx:KeywordField ;
    idx:stored false ;
    idx:facetable true .

field:status
    idx:fieldName "status" ;
    idx:fieldType idx:KeywordField ;
    idx:stored false ;
    idx:facetable true .

field:year
    idx:fieldName "year" ;
    idx:fieldType idx:IntField ;
    idx:stored false ;
    idx:sortable true ;
    idx:facetable true .

field:publishedOn
    idx:fieldName "publishedOn" ;
    idx:fieldType idx:TemporalField ;
    idx:stored false ;
    idx:sortable true ;
    idx:facetable true ;
    idx:storeLiteralMetadata true .

field:indexedAt
    idx:fieldName "indexedAt" ;
    idx:fieldType idx:TemporalField ;
    idx:stored false ;
    idx:sortable true ;
    idx:storeLiteralMetadata true .

## Searchable from the main box: the notes are prose, they are the only multilingual
## values in the dataset, and a note in French should be findable by a French word.
## Without idx:defaultSearch the field is indexed but unreachable through fieldSpec
## "default", so a query for a term only it contains silently returns nothing.
field:reviewNote
    idx:fieldName "reviewNote" ;
    idx:fieldType idx:TextField ;
    idx:stored false ;
    idx:multiValued true ;
    idx:defaultSearch true .

field:qaPassed
    idx:fieldName "qaPassed" ;
    idx:fieldType idx:KeywordField ;
    idx:stored false ;
    idx:facetable true .

field:confidenceScore
    idx:fieldName "confidenceScore" ;
    idx:fieldType idx:DoubleField ;
    idx:stored false ;
    idx:facetable true ;
    idx:sortable true .

## The picklist/facet side of a name: exact values, counted, filtered with "=".
field:authorName
    idx:fieldName "authorName" ;
    idx:fieldType idx:KeywordField ;
    idx:stored false ;
    idx:facetable true .

## The search side of the same name. No analyzer, so the index-wide StandardAnalyzer
## applies and BM25 ranks the match — which is what a name typed into the search box
## needs. Prefix completion is the picklist's job, not this field's.
field:authorNameText
    idx:fieldName "authorNameText" ;
    idx:fieldType idx:TextField ;
    idx:stored false ;
    idx:defaultSearch true .

field:authoredByUri
    idx:fieldName "authoredByUri" ;
    idx:fieldType idx:KeywordField ;
    idx:stored false ;
    idx:multiValued true .

field:attributionRole
    idx:fieldName "attributionRole" ;
    idx:fieldType idx:KeywordField ;
    idx:stored true ;             # projected by luc:nestedMatch
    idx:facetable true ;
    idx:multiValued true .

## Exact side of the agent name: equality filters and facet counts.
field:attributionAgentExact
    idx:fieldName "attributionAgentExact" ;
    idx:fieldType idx:KeywordField ;
    idx:stored true ;             # projected by luc:nestedMatch
    idx:facetable true ;
    idx:multiValued true .

## Search side, and what the agent filter box actually queries. No analyzer, so the
## index-wide StandardAnalyzer applies and BM25 scores it: "Jones" and "Sarah Jones" both
## reach "Dr Sarah Jones", and the clause still folds same-child with the role clause.
## Deliberately not an edge-ngram twin — n-gramming a name expands every value to ~10-20
## tokens, makes IDF meaningless, and buys prefix completion that costs a vocabulary
## round trip to use. Whatever the author count, this field is the same size and speed.
field:attributionAgentText
    idx:fieldName "attributionAgentText" ;
    idx:fieldType idx:TextField ;
    idx:stored false ;
    idx:multiValued true .

field:depth
    idx:fieldName "depth" ;
    idx:fieldType idx:IntField ;
    idx:stored false ;
    idx:sortable true ;
    idx:facetable true .

## Identifiers are dashed ("RPT-MIA-2023-001"), and people search by the segment they
## remember, so these are per-word too. Drop idx:tokenized to require typing from the
## start of the value instead.
field:identifier
    idx:fieldName "identifier" ;
    idx:fieldType idx:TextField ;
    idx:stored false ;
    idx:multiValued true ;
    idx:analyzer [ a text:EdgeNGramAnalyzer ; text:tokenized true ] .

field:identifierType
    idx:fieldName "identifierType" ;
    idx:fieldType idx:KeywordField ;
    idx:stored false ;
    idx:facetable true ;
    idx:multiValued true .

## Sortable as well as facetable, to demonstrate ordering by a value that lives on a
## nested child. A sort spec supplies a selector naming which child to read - see the
## "Nested Sort" cases in tests.json - so the parent is ordered by, say, its anumber
## without that value being flattened onto the parent document.
field:identifierValueExact
    idx:fieldName "identifierValueExact" ;
    idx:fieldType idx:KeywordField ;
    idx:stored false ;
    idx:facetable true ;
    idx:sortable true ;
    idx:multiValued true .

field:identifierValueText
    idx:fieldName "identifierValueText" ;
    idx:fieldType idx:TextField ;
    idx:stored false ;
    idx:multiValued true ;
    idx:analyzer [ a text:EdgeNGramAnalyzer ; text:tokenized true ] .

field:location
    idx:fieldName "location" ;
    idx:fieldType idx:LatLonField ;
    idx:stored false .

## --- External assay fields ---
## No sh:path: these come from bound CSV columns, not from the graph. A field is
## external because a column binds it — there is no idx:external flag.
## See docs/03-configuration.md#external-content-csvtsv

field:analyte
    idx:fieldName "analyte" ;
    idx:fieldType idx:KeywordField ;
    idx:indexed   true ;
    idx:facetable true ;
    idx:stored    true .          # short, non-volatile label

field:grade
    idx:fieldName "grade" ;
    idx:fieldType idx:DoubleField ;
    idx:indexed   true ;          # range filters
    idx:facetable true ;          # range facets
    idx:sortable  true ;          # nested sort selector
    idx:stored    true .          # projected by luc:nestedMatch, so a filtered hit can
                                  # show the assay that matched. Storing a volatile number
                                  # means the index must be rebuilt when it changes; the
                                  # assay database remains the source of truth.

field:gradeUnits
    idx:fieldName "gradeUnits" ;
    idx:fieldType idx:KeywordField ;
    idx:indexed   true ;
    idx:facetable true ;
    idx:stored    true .

field:belowDetection
    idx:fieldName "belowDetection" ;
    idx:fieldType idx:KeywordField ;
    idx:indexed   true ;
    idx:facetable true ;
    idx:stored    true .

## --- Shapes ---

:MiningReportShape
    sh:targetClass ex:MiningReport ;
    sh:property [ idx:field field:entityType ; sh:path rdf:type ] ;
    sh:property [ idx:field field:title ; sh:path rdfs:label ] ;
    sh:property [ idx:field field:identifier ; sh:path ex:identifier ] ;
    sh:property [ idx:field field:description ; sh:path <http://purl.org/dc/terms/description> ] ;
    sh:property [ idx:field field:commodity ; sh:path ex:commodity ] ;
    sh:property [ idx:field field:state ; sh:path ex:state ] ;
    sh:property [ idx:field field:operator ; sh:path ex:operator ] ;
    sh:property [ idx:field field:status ; sh:path ex:status ] ;
    sh:property [ idx:field field:year ; sh:path ex:year ] ;
    sh:property [ idx:field field:publishedOn ; sh:path ex:publishedOn ] ;
    sh:property [ idx:field field:indexedAt ; sh:path ex:indexedAt ] ;
    sh:property [ idx:field field:reviewNote ; sh:path ex:reviewNote ] ;
    sh:property [ idx:field field:qaPassed ; sh:path ex:qaPassed ] ;
    sh:property [ idx:field field:confidenceScore ; sh:path ex:confidenceScore ] ;
    sh:property [ idx:field field:authorName ; sh:path ( ex:authoredBy ex:name ) ] ;
    sh:property [ idx:field field:authorNameText ; sh:path ( ex:authoredBy ex:name ) ] ;
    sh:property [ idx:field field:authoredByUri ; sh:path [ sh:inversePath ex:authored ] ] ;
    ## Correlated identifier records: company, anumber and mnumber on one report.
    ## Lives here rather than on BoreholeShape so it is exercised by the change
    ## listener. BoreholeShape is rebuild-only because of its external assay source,
    ## which would tie this feature's tests to that one.
    idx:nested [
        idx:joinPath schema:identifier ;
        idx:property [ idx:field field:identifierType ; sh:path schema:propertyID ] ;
        idx:property [ idx:field field:identifierValueExact ; sh:path schema:value ] ;
        idx:property [ idx:field field:identifierValueText ; sh:path schema:value ] ;
        idx:facetHierarchy ( field:identifierType field:identifierValueExact ) ;
    ] ;

    idx:nested [
        idx:joinPath prov:qualifiedAttribution ;
        idx:property [ idx:field field:attributionRole ; sh:path ( prov:hadRole rdfs:label ) ] ;
        idx:property [ idx:field field:attributionAgentExact ; sh:path ( prov:agent rdfs:label ) ] ;
        idx:property [ idx:field field:attributionAgentText ; sh:path ( prov:agent rdfs:label ) ] ;
    ] ;
    idx:facetHierarchy ( field:state field:commodity ) .

:BoreholeShape
    sh:targetClass ex:Borehole ;
    sh:property [ idx:field field:entityType ; sh:path rdf:type ] ;
    sh:property [ idx:field field:title ; sh:path rdfs:label ] ;
    sh:property [ idx:field field:identifier ; sh:path ex:identifier ] ;
    sh:property [ idx:field field:description ; sh:path <http://purl.org/dc/terms/description> ] ;
    sh:property [ idx:field field:commodity ; sh:path ex:commodity ] ;
    sh:property [ idx:field field:state ; sh:path ex:state ] ;
    sh:property [ idx:field field:depth ; sh:path ex:depth ] ;
    sh:property [ idx:field field:location ; sh:path <http://www.opengis.net/ont/geosparql#asWKT> ] ;

    ## Assay results from a CSV that is never loaded into the graph. One child
    ## document per row, joined on the borehole IRI at index time — so a single
    ## query can constrain across graph fields and assay values together.
    ##
    ## Four columns land on ONE child, so they correlate: "Cu above 1 pct and above
    ## detection" must be satisfied by the same assay, not by three different ones.
    ##
    ## Rebuild-only: run `task index` after loading. A live graph edit cannot
    ## re-derive these children, so the doc producer refuses rather than dropping them.
    idx:nested [
        idx:nestedName "assay" ;
        idx:externalSource [
            idx:format        idx:CsvFile ;
            idx:location      "data/assays.csv" ;
            idx:subjectColumn "borehole" ;

            ## Applied over the base at build time: DELETE removes matching children,
            ## ADD appends. Deletes run before adds, so file order cannot change the
            ## result. An empty cell in a DELETE is a wildcard for that column.
            idx:delta         "data/assays-delta.csv" ;

            idx:column [ idx:columnName "analyte"         ; idx:field field:analyte ] ;
            idx:column [ idx:columnName "grade"           ; idx:field field:grade ] ;
            idx:column [ idx:columnName "units"           ; idx:field field:gradeUnits ] ;
            idx:column [ idx:columnName "below_detection" ; idx:field field:belowDetection ] ;
        ] ;
        idx:facetHierarchy ( field:analyte field:gradeUnits ) ;
    ] ;

    idx:facetHierarchy ( field:state field:commodity ) .

:SiteShape
    sh:targetClass ex:Site ;
    sh:property [ idx:field field:entityType ; sh:path rdf:type ] ;
    sh:property [ idx:field field:title ; sh:path rdfs:label ] ;
    sh:property [ idx:field field:identifier ; sh:path ex:identifier ] ;
    sh:property [ idx:field field:description ; sh:path <http://purl.org/dc/terms/description> ] ;
    sh:property [ idx:field field:commodity ; sh:path ex:commodity ] ;
    sh:property [ idx:field field:state ; sh:path ex:state ] ;
    sh:property [ idx:field field:status ; sh:path ex:status ] ;
    sh:property [ idx:field field:location ; sh:path <http://www.opengis.net/ont/geosparql#asWKT> ] ;
    idx:facetHierarchy ( field:state field:commodity ) .
