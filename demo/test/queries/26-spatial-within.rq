# Counts below are for the full demo dataset (mining.ttl + generated.ttl). The
# generated sites and boreholes contribute additional matches; the named sites are
# the ones placed deliberately to demonstrate the behaviour.
# s_within: the indexed shape lies wholly inside the query geometry.
#
# 14 rows. Look for site-excised-tenement, site-legacy-survey, site-datum-gda2020
# and site-datum-crs84; the rest are generated boreholes and sites in the same area.
#
# Not returned, and each for its own reason:
#   site-drill-collars   its two collars are outside this box
#   site-no-geometry     an entity with no geometry is in no spatial result at all
PREFIX luc: <urn:jena:lucene:index#>
SELECT ?entity ?score WHERE {
  (?hit ?entity ?score) luc:query ("default" "default" "*"
    '{"op":"s_within","args":[{"property":"urn:jena:lucene:field#location"},{"bbox":[120.5,-31.5,122.5,-30.0]}]}'
    ""
    20
    0)
}
