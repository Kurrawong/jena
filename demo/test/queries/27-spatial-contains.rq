# s_contains: the indexed shape encloses the query geometry.
#
# Expected: the Kalgoorlie excised tenement, whose polygon encloses this small box.
# Point-indexed sites are never returned by s_contains: a point encloses nothing.
PREFIX luc: <urn:jena:lucene:index#>
SELECT ?entity ?score WHERE {
  (?hit ?entity ?score) luc:query ("default" "default" "*"
    '{"op":"s_contains","args":[{"property":"urn:jena:lucene:field#location"},{"bbox":[121.25,-30.95,121.35,-30.85]}]}'
    ""
    20
    0)
}
