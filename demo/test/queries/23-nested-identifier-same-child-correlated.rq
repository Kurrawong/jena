#
# Same-child correlated filter on nested identifier records (issue #65).
#
# Filter: identifierType = "anumber" AND text_query(identifierValueText, "A-94")
#
# `=` is exact-term match (KEYWORD semantics); `text_query` is analyzer-aware
# text matching that runs the supplied text through the field's configured
# query analyzer. The edge-ngram field `identifierValueText` is lowercased
# at index time, so "A-94" via text_query matches the indexed "a-94" n-gram.
#
# Both clauses live in the same CqlAnd subtree and both target the
# `identifier` idx:nested scope. The compiler's same-scope fold combines
# them into ONE inner BooleanQuery wrapped in ONE ToParentBlockJoinQuery so
# that a report surfaces only when ONE identifier record satisfies BOTH
# constraints — type=anumber AND value matching the "A-94" n-gram.

PREFIX luc: <urn:jena:lucene:index#>

SELECT ?s ?score
WHERE {
    (?hit ?s ?score) luc:query (
        "default"
        "default"
        "*"
        '{"op":"and","args":[{"op":"=","args":[{"property":"urn:jena:lucene:field#identifierType"},"anumber"]},{"op":"text_query","args":[{"property":"urn:jena:lucene:field#identifierValueText"},"A-94"]}]}'
        ""
        10
        0
    )
}
ORDER BY DESC(?score) ?s
