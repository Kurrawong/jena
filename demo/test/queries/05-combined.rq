# Search results and facet counts in a single query using UNION.
# Returns N + M rows (not a cartesian product).
# Hit rows have ?field/?value/?low/?high/?count unbound; facet rows have ?entity/?score unbound.
# Both property functions share a single Lucene execution internally.

PREFIX luc: <urn:jena:lucene:index#>

SELECT ?entity ?score ?field ?value ?low ?high ?count
WHERE {
    { (?hit ?entity ?score) luc:query ("default" "default" "iron ore" "" "" 10) }
    UNION
    { (?field ?value ?low ?high ?count) luc:facet ("default" "default" "iron ore" '["urn:jena:lucene:field#state", "urn:jena:lucene:field#status"]' "" 10 0) }
}
